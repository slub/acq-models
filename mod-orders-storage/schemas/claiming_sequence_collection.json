  "description": "Collection of claiming sequences",
  "type": "object",
  "properties": {
    "claimingSequences": {
      "description": "Collection of claiming sequences",
      "type": "array",
      "id": "claimingSequences",
      "items": {
        "type": "object",
        "$ref": "claiming_sequence.json"
